# Supabase -> Project Settings -> Database -> Connection string
# Pooled connection (port 6543) used by the app at runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) used by Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Seed accounts (leave passwords blank to auto-generate; they are printed once)
SEED_OWNER_EMAIL="owner@lutherpaddlepoint.local"
SEED_OWNER_PASSWORD=""
SEED_STAFF_PASSWORD=""

# Public address of the site (used in PayMongo return links)
APP_URL="http://localhost:3000"

# Supabase -> Project Settings -> API. The service role key is SECRET: server only, never share it.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
PROOF_BUCKET="payment-proofs"

# PayMongo (later, after business registration). Use test keys (sk_test_...) first.
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# Staff/owner login sessions. Make a long random value, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Email (Gmail): turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters below.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="yourgmail@gmail.com"
SMTP_PASS=""
EMAIL_FROM="Luther PaddlePoint & Pool <yourgmail@gmail.com>"

# SMS (optional): Semaphore API key from semaphore.co. Leave empty to send no SMS.
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME=""

# Protects the scheduled job URL (/api/cron/run). Any long random value.
CRON_SECRET=""
